# 依赖与缓存
node_modules/
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# tools/gen-globe-data.py 从 CDN 拉下来的 Natural Earth 原始 TopoJSON（约 160KB）
# 只是本地生成缓存，需要时脚本会自己重新下载，不入库
.cache/

# 本地试听用的无损副本（体积大，不部署；网页用 mp3）
assets/audio/music/*.wav
assets/audio/music/preview-*

# tools/trim-audio.py 裁剪前的原始片段备份（体积约 1.6MB，只用于回滚，不必入库）
assets/audio/.orig/

# 测试临时产物
tools/last-dom.html
tools/shots/
tools/_probe/
# 排查用的一次性脚本与日志（下划线前缀表示临时，正式脚本不带下划线）
tools/_*.mjs
tools/_*.log

# 素材核对用的预览图（由 tools/preview-*.py 生成，随时可重跑，不入库）
tools/globe-preview.png
tools/globe-textures-preview.png
tools/globe-border-crops.png
tools/globe-zoom-preview.png

# 编辑器
.vscode/
.idea/
